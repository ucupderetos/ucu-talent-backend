# Copiar este archivo a .env y completar con valores reales.
#
# Este es el modo LOCAL: la app le pega a un Postgres levantado por Docker, que
# es tuyo y descartable. Es el modo que usa todo el equipo de backend, y las
# migraciones de Flyway se aplican sobre esa base, nunca sobre la de dev.
#
#     docker compose up          -> levanta db + api
#     docker compose down -v     -> borra la base; Flyway la reconstruye desde V1

COMPOSE_PROFILES=local

APP_PORT=8080

# Puerto en el que se publica el Postgres local en tu maquina. Cambialo si ya
# tenes algo ocupando el 5432.
POSTGRES_PORT=5432

POSTGRES_DB=ucu_talent_database_dev

# Usuario utilizado por la aplicación. En local es el unico rol que crea la
# imagen de Postgres al iniciar, asi que Flyway usa el mismo.
POSTGRES_USER=talent_user
POSTGRES_PASSWORD=password

# Usuario utilizado por Flyway. En local apunta al mismo rol que la app; el rol
# 'flyway_user' separado solo existe en la base hosteada.
FLYWAY_USER=talent_user
FLYWAY_PASSWORD=password

# Solo se usan si corres la app desde el IDE en vez de con Docker. Dentro de
# compose el host lo define cada servicio (db / cloud-sql-proxy).
DB_HOST=localhost
DB_PORT=5432

# --- JWT (auth stateless) ----------------------------------------------------
#
# Secreto HMAC usado para firmar y validar los JWT. Nunca lo hardcodees ni lo
# subas a git. Generalo con, por ejemplo:
#
#     openssl rand -base64 48
#
# y pegalo aca abajo (en tu .env local, no en este .env.example).
JWT_SECRET=cambiar-por-un-secreto-random-de-32-caracteres-o-mas

# Duracion del access token en minutos. Opcional, default 60.
JWT_EXPIRATION_MINUTES=60

# Origen exacto del front (Next.js) para CORS. Nunca "*" (no funciona junto con
# credenciales/cookies). Cambialo cuando el front confirme su dominio real.
CORS_ALLOWED_ORIGIN=http://localhost:3000


# --- Modo HOSTED (Cloud SQL) -------------------------------------------------
#
# Solo para quien administra la base de dev. Una migracion aplicada aca impacta
# a todo el equipo y no se deshace borrando un volumen.
#
# No mezclar con el bloque de arriba: va en un archivo aparte (.env.dev) que se
# levanta explicitamente con:
#
#     docker compose --env-file .env.dev up
#
# COMPOSE_PROFILES=hosted
# POSTGRES_USER=<usuario real de la app>
# POSTGRES_PASSWORD=<password real>
# FLYWAY_USER=flyway_user
# FLYWAY_PASSWORD=<password real de flyway>
# CLOUD_SQL_INSTANCE=your-project:your-region:your-instance
# GOOGLE_APPLICATION_CREDENTIALS_HOST=/path/to/application_default_credentials.json
#
# En Windows, el archivo de credenciales normalmente se encuentra en:
# C:\Users\<USUARIO>\AppData\Roaming\gcloud\application_default_credentials.json
